config.ini

# Fichiers générés pendant l'utilisation
stuff_run.cfg
*.tmp
*.bak

# Système / éditeurs
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Executable compile en local (build_exe.bat)
*.exe

# Guide administrateur (prive, ne doit jamais etre envoye sur GitHub)
README_ADMIN.md
